# rtsp-streaming 설정 예시. 설치 스크립트가 이 파일로 .env를 만듭니다.

# ── 포트 ──
# 비워 두면 설치할 때 이 PC에서 사용 가능한 포트를 고릅니다.
BACKEND_PORT=
FRONTEND_PORT=

# ── mediamtx ──
# API 주소는 컨테이너 사이에서 사용합니다. 아래 포트 4개는 설치할 때 채웁니다.
MEDIAMTX_API=http://mediamtx:9997
MEDIAMTX_API_PORT=
MEDIAMTX_RTSP_PORT=
MEDIAMTX_WEBRTC_PORT=
MEDIAMTX_ICE_UDP_PORT=
# 묻기: 다른 PC나 휴대폰에서도 영상을 보려면 이 PC의 IP 주소를 입력하세요. 이 PC에서만 보면 Enter를 누르세요.
MEDIAMTX_WEBRTC_HOST=
# backend는 제어(API)용, viewer는 시청용입니다. 빈 비밀번호는 설치할 때 각각 생성합니다.
MEDIAMTX_BACKEND_PASS=
MEDIAMTX_VIEWER_USER=viewer_rtsp_streaming
MEDIAMTX_VIEWER_PASS=
