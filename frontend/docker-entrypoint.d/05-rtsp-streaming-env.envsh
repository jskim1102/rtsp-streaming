#!/bin/sh
# 프록시 설정 템플릿에 넣을 값을 만든다 (공식 이미지의 20-envsubst-on-templates.sh 보다 먼저 돈다).
# - 이 파일은 source 된다. envsubst 는 자식 프로세스라 export 한 값만 본다.

# WHEP 경로 앞부분 — backend/app/models.py 의 stream_key_prefix() 와 같은 규칙이다.
if [ -n "${MEDIAMTX_PATH_PREFIX:-}" ]; then
    WHEP_PATH_PREFIX="${MEDIAMTX_PATH_PREFIX}__ipcam-"
else
    WHEP_PATH_PREFIX="ipcam-"
fi
# 정규식 location 에 그대로 들어가므로 정규식 특수문자를 이스케이프한다.
# 접두사 글자를 따로 제한하지 않아, 지금 동작하는 설정이 업데이트 뒤 기동 실패로 바뀌지 않는다.
WHEP_PATH_PREFIX=$(printf '%s' "$WHEP_PATH_PREFIX" | sed 's/[][\.*^$()+?{}|]/\\&/g')

# WHEP 요청에 붙일 viewer 자격증명 — 프록시가 붙이고 브라우저에는 보내지 않는다.
# base64 는 기본 76자에서 줄을 바꿔 긴 비밀번호면 헤더가 두 줄로 깨지므로 -w0 으로 한 줄을 만든다.
# 비밀번호가 비는 경우는 compose 의 ${MEDIAMTX_VIEWER_PASS:?…} 가 미리 막는다.
VIEWER_AUTHORIZATION="Basic $(printf '%s' "${MEDIAMTX_VIEWER_USER:-}:${MEDIAMTX_VIEWER_PASS:-}" | base64 -w0)"

export WHEP_PATH_PREFIX VIEWER_AUTHORIZATION
